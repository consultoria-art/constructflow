generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  active    Boolean  @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus  String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  projects  Project[]
  materials Material[]
  taskColumns TaskColumn[]
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  comments       Comment[]
  assignedTasks  Task[]
  responsibleProjects Project[]
}
model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  status         String   @default("active")
  budget         Float    @default(0)
  spent          Float    @default(0)
  responsible    String?
  responsibleId  String?
  responsibleUser User?   @relation(fields: [responsibleId], references: [id])
  startDate      DateTime?
  deadline       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tasks      Task[]
  alerts     Alert[]
  movements  StockMovement[]
  comments   Comment[]
  expenses   Expense[]
  risks      RiskIssue[]
  documents  Document[]
}
model TaskColumn {
  id             String   @id @default(cuid())
  name           String
  color          String   @default("#6b7280")
  order          Int      @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("tarefa")
  status      String   @default("pending")
  priority    String   @default("medium")
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  startDate   DateTime?
  deadline    DateTime?
  replannedDeadline DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  progress    Int      @default(0)
  hoursLogged Float    @default(0)
  cost        Float    @default(0)
  isMilestone Boolean  @default(false)
  parentId    String?
  parent      Task?    @relation("TaskParent", fields: [parentId], references: [id])
  children    Task[]   @relation("TaskParent")
  documents   Document[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}
model Alert {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}
model Material {
  id             String   @id @default(cuid())
  name           String
  unit           String   @default("un")
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  movements      StockMovement[]
}
model StockMovement {
  id          String   @id @default(cuid())
  type        String
  quantity    Float
  unitValue   Float    @default(0)
  notes       String?
  responsible String?
  createdAt   DateTime @default(now())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
}
model Comment {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String?
  date        DateTime @default(now())
  responsible String?
  createdAt   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
}
model RiskIssue {
  id          String   @id @default(cuid())
  type        String   @default("risco")
  title       String
  description String?
  probability String?
  impact      String?
  status      String   @default("aberto")
  createdAt   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
}
model Document {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  data       String
  uploadedBy String?
  createdAt  DateTime @default(now())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
}
